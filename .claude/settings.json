{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/looper.js\" inject",
            "timeout": 30,
            "statusMessage": "looper: reading this project's rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/looper.js\" hook PostToolUse",
            "timeout": 30,
            "statusMessage": "looper: checking that edit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/looper.js\" hook PreToolUse",
            "timeout": 300,
            "statusMessage": "looper: checking what is about to be committed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/looper.js\" hook Stop",
            "timeout": 30,
            "statusMessage": "looper: updating what is left to fix"
          }
        ]
      }
    ]
  }
}
